# Root-owned shell configuration, mode 0600: plain KEY=value lines, all exported.
# Use an SSH alias from /root/.ssh/config.
SOURCE=nextcloud-files-source

# Use a NEW dedicated Borg repository. Example offsite destination.
BORG_REPO=ssh://nextcloud-files-store/./borg/nextcloud-files
BORG_REMOTE_PATH=borg-1.4
BORG_PASSCOMMAND='cat /etc/nextcloud-files-backup.passphrase'

# For a local repo, set BORG_REPO to an absolute path on separate storage
# and remove the BORG_REMOTE_PATH line.

# Optional: requested once after every successful run. A monitor that expects
# this request alerts when it stops arriving. The URL acts as a password.
#PING_URL=https://monitor.example/ping/UUID
