# Add to /root/.ssh/config on the backup host. The job passes its own
# unattended-run options (BatchMode, timeouts) to rsync and Borg, so only the
# address and identity belong here. StrictHostKeyChecking also makes the
# interactive setup checks fail on a host key that was not installed beforehand.
Host nextcloud-files-source
    HostName nextcloud-host
    User root
    IdentityFile /root/.ssh/id_ed25519_nextcloud_files
    IdentitiesOnly yes
    StrictHostKeyChecking yes

Host nextcloud-files-store
    HostName USER.your-storagebox.de
    User USER
    Port 23
    IdentityFile /root/.ssh/id_ed25519_nextcloud_files_store
    IdentitiesOnly yes
    StrictHostKeyChecking yes
